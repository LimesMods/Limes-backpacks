{
	"schemaVersion": 1,
	"id": "limesbackpacks",
	"version": "1.0.1",

	"name": "Lime's Backpacks",
	"description": "Six wearable expedition backpacks with storage, equipment, lanterns and a quiver.",
	"authors": [
		"Lime"
	],

	"environment": "*",

	"entrypoints": {
		"main": [
			"com.lime.backpacks.LimesBackpacks"
		],
		"client": [
			"com.lime.backpacks.client.LimesBackpacksClient"
		],
		"lambdynlights:initializer": [
			"com.lime.backpacks.client.lighting.BackpackDynamicLights"
		]
	},

	"mixins": [
		"limesbackpacks.mixins.json",
		"limesbackpacks.client.mixins.json"
	],

	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"trinkets": ">=3.11.0-beta.2",
		"lambdynlights": ">=4.9.1"
	}
}
