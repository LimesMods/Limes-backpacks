{
	"schemaVersion": 1,
	"id": "limesbackpacks",
	"version": "${version}",

	"name": "Lime's Backpacks",
	"description": "Vanilla+ wearable backpacks. Upgrade from a humble leather pack to a Netherite backpack with a lantern and quiver.",
	"authors": [
		"Lime"
	],
	"license": "LicenseRef-All-Rights-Reserved",
	"contact": {
		"homepage": "https://modrinth.com/mod/limesbackpacks",
		"sources": "https://github.com/LimesMods/Limes-backpacks",
		"issues": "https://github.com/LimesMods/Limes-backpacks/issues"
	},

	"environment": "*",

	"entrypoints": {
		"main": [
			"com.lime.backpacks.LimesBackpacks"
		],
		"client": [
			"com.lime.backpacks.client.LimesBackpacksClient"
		],
		"lambdynlights:initializer": [
			"com.lime.backpacks.client.lighting.BackpackDynamicLights"
		]
	},

	"mixins": [
		"limesbackpacks.mixins.json",
		"limesbackpacks.client.mixins.json"
	],

	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"trinkets": ">=3.11.0-beta.2",
		"lambdynlights": ">=4.9.1"
	}
}
